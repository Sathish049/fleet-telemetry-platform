{
  "uid": "fleet-pipeline",
  "title": "Fleet Telemetry Pipeline",
  "schemaVersion": 39,
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Ingest rate",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ingest_messages_received_total[1m]))"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Open WebSocket connections",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(ingest_ws_connections)"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Writer lag (stream entries)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(writer_stream_lag)"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "p95 end-to-end latency",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(writer_end_to_end_seconds_bucket[1m])) by (le))"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Messages per second",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ingest_messages_received_total[1m]))",
          "legendFormat": "received"
        },
        {
          "refId": "B",
          "expr": "sum(rate(ingest_messages_published_total[1m]))",
          "legendFormat": "published to Redis"
        },
        {
          "refId": "C",
          "expr": "sum(rate(writer_rows_written_total[1m]))",
          "legendFormat": "written to MySQL"
        },
        {
          "refId": "D",
          "expr": "sum(rate(writer_duplicates_ignored_total[1m]))",
          "legendFormat": "duplicates ignored"
        },
        {
          "refId": "E",
          "expr": "sum(rate(ingest_messages_rejected_total[1m]))",
          "legendFormat": "rejected"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Latency (p50 / p95 / p99)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum(rate(writer_end_to_end_seconds_bucket[1m])) by (le))",
          "legendFormat": "end-to-end p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum(rate(writer_end_to_end_seconds_bucket[1m])) by (le))",
          "legendFormat": "end-to-end p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum(rate(writer_end_to_end_seconds_bucket[1m])) by (le))",
          "legendFormat": "end-to-end p99"
        },
        {
          "refId": "D",
          "expr": "histogram_quantile(0.95, sum(rate(writer_batch_seconds_bucket[1m])) by (le))",
          "legendFormat": "MySQL batch p95"
        },
        {
          "refId": "E",
          "expr": "histogram_quantile(0.95, sum(rate(ingest_publish_batch_seconds_bucket[1m])) by (le))",
          "legendFormat": "Redis publish p95"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Backlog",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(ingest_queue_depth)",
          "legendFormat": "ingest in-memory queue"
        },
        {
          "refId": "B",
          "expr": "sum(writer_stream_lag)",
          "legendFormat": "stream lag"
        },
        {
          "refId": "C",
          "expr": "sum(writer_pending_messages)",
          "legendFormat": "pending (unacked)"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Errors and alerts",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ingest_publish_errors_total[1m]))",
          "legendFormat": "Redis publish errors"
        },
        {
          "refId": "B",
          "expr": "sum(rate(writer_db_errors_total[1m]))",
          "legendFormat": "MySQL write errors"
        },
        {
          "refId": "C",
          "expr": "sum(rate(writer_alerts_total[5m])) * 60",
          "legendFormat": "alerts per minute"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "API requests per second (by route)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(api_requests_total[1m])) by (route)",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "API p95 latency (by route)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(api_request_seconds_bucket[1m])) by (le, route))",
          "legendFormat": "{{route}}"
        }
      ]
    }
  ]
}